# Copy to .env and fill in the values. Do not commit .env.
# Legacy RODGERDATABASE and RODGERICON still work when the Mika names are unset.

# Required. Bot token from the Discord Developer Portal > Bot.
TOKEN=

# Required. Application ID from the Discord Developer Portal > General Information.
# Used to register global slash commands on startup.
APPLICATIONID=

# Required. MongoDB connection string for configuration, infractions, warnings, and leveling.
# From your MongoDB host. DigitalOcean managed MongoDB: database dashboard, then download the CA.
# Shape, including tlsCAFile: mongodb+srv://USER:PASSWORD@HOST/DATABASE?tls=true&authSource=admin&tlsCAFile=./ca-certificate.crt
# Keep the real URI and the certificate out of git.
MIKADATABASE=

# Optional. Database name passed to mongoose.connect as dbName. Defaults to mika.
# Overrides a database name in MIKADATABASE. If this is unset and the URI has no
# database, MongoDB would use "test". Documents already stored in "test" are not
# moved. Set this to test only to keep reading that database; otherwise copy those
# collections into mika yourself, or leave them and let Mika create new ones.
MIKADATABASENAME=

# Optional. Public image URL used as the footer icon on embeds.
# When unset, embeds use https://renos.world/wp-content/uploads/2025/10/5a4e299d7d70aace-952x1024.jpg
MIKAICON=
