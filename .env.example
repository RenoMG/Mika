# Discord bot token (Developer Portal → Bot)
TOKEN=

# Application ID (Developer Portal → General Information)
APPLICATIONID=

# MongoDB connection string used for configuration, infractions, warnings, and leveling.
# MIKADATABASE is preferred. RODGERDATABASE is still read when MIKADATABASE is unset.
# Put the real username, password, and host only in .env. Never commit that file.
# DigitalOcean managed MongoDB uses a private CA. Download the CA from the database
# dashboard and point tlsCAFile at that local file. Certificates and private keys
# (*.crt, *.pem, *.key, and similar) are gitignored.
MIKADATABASE=mongodb+srv://USER:PASSWORD@HOST/DATABASE?tls=true&authSource=admin&tlsCAFile=./ca-certificate.crt
# RODGERDATABASE=

# Public image URL used as the footer icon on embeds.
# MIKAICON is preferred. When both are unset, embeds use:
# https://renos.world/wp-content/uploads/2025/10/5a4e299d7d70aace-952x1024.jpg
# RODGERICON is still read when MIKAICON is unset, except the old Discord CDN
# avatar for this application (cdn.discordapp.com/avatars/795165717283471370),
# which is replaced with that placeholder.
MIKAICON=
# RODGERICON=

# Legacy Reddit OAuth values. No current command reads these.
# RedditCLIENTID=
# RedditCLIENTSECRET=
# RedditREFRESHTOKEN=
