    "dotenv": "^16.6.1",
    "mongoose": "^9.1.1"
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "eslint-plugin-promise": "^7.3.0",
    "globals": "^17.14.0",
    "mongodb-memory-server": "^11.4.0"
  }
